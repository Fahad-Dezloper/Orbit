{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Orbit",
  "description": "Live market depth for Stellar RWAs, so lenders know what's safe to accept as collateral.",
  "colors": {
    "primary": "#0F9D58",
    "light": "#7FFAB7",
    "dark": "#121312"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "fonts": {
    "heading": {
      "family": "Inter Tight",
      "weight": 300
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "background": {
    "color": {
      "light": "#F5F5F5",
      "dark": "#121312"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://fahad-dezloper.github.io/Orbit/dashboard/"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/Fahad-Dezloper/Orbit"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "how-it-works"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/the-problem",
              "concepts/exit-liquidity",
              "concepts/reference-price",
              "concepts/worst-of-the-day",
              "concepts/safe-limit",
              "concepts/venues",
              "concepts/token-verification"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/lenders",
              "guides/liquidators",
              "guides/self-hosting"
            ]
          },
          {
            "group": "Trust and limits",
            "pages": [
              "security/threat-model",
              "security/limits"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/faq",
              "resources/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Live data",
        "groups": [
          {
            "group": "Live data",
            "pages": [
              "live/overview",
              "live/tokens"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "HTTP API",
            "pages": [
              "api/overview",
              "api/latest",
              "api/asset",
              "api/history",
              "api/cap",
              "api/lenders"
            ]
          },
          {
            "group": "On-chain oracle",
            "pages": [
              "contract/overview",
              "contract/reading"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Fahad-Dezloper/Orbit"
    }
  },
  "appearance": {
    "default": "light"
  }
}
