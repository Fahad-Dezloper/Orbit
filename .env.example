# Copy to .env and adjust. Never put a secret key in this file.

# ---- API (measurement + HTTP) ----
ORBIT_API_PORT=8080
ORBIT_DASHBOARD_PORT=3100
# Average seconds between readings (minimum 300, randomized by +/-25%).
ORBIT_INTERVAL_SECS=1800
ORBIT_HORIZON=https://horizon.stellar.org

# ---- Publisher (only with: docker compose --profile publisher up) ----
# Deploy your own oracle first: scripts/deploy-oracle.sh --network testnet
ORBIT_NETWORK=testnet
ORBIT_ORACLE=
# The publisher's public key (G...). The container refuses to start if the key file differs.
ORBIT_PUBLISHER_ADDRESS=
# File holding the publisher's secret key (S...), mounted as a Docker secret.
# Create it with: stellar keys show <identity> > secrets/publisher.key && chmod 600 secrets/publisher.key
ORBIT_PUBLISHER_KEY_FILE=./secrets/publisher.key
ORBIT_PUBLISH_EVERY_SECS=1800
# Test networks only: publish with fewer than 12 readings while history builds.
ORBIT_MIN_SAMPLES=
# Mainnet only, and only once you accept the oracle has not had an external review: yes
ORBIT_MAINNET_UNAUDITED=
